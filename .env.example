# Copy this file to `.env.local` for local development.
# Never commit real secrets. Placeholders only.

# The public URL of the deployed menu (used for QR code generation, SEO, sitemap, and WhatsApp receipt tracking).
# In Vercel Production: https://alnaker.vercel.app
NEXT_PUBLIC_SITE_URL=https://alnaker.vercel.app

# PostgreSQL connection string from Neon. Use the pooled connection (-pooler) for serverless environments.
# Must point to the active production database cluster.
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-YOUR-PROJECT-pooler.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require

# Data storage mode:
# Set to 'false' in production and staging so the application queries PostgreSQL directly.
# Set to 'true' only for local offline development using JSON fallback.
USE_BACKUP_DATA=false

# Session signing secret.
# MUST be freshly generated for every environment (>= 32 random characters).
# e.g. `openssl rand -hex 32` or `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
# Never reuse a value that has ever been committed, shared, or deployed.
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Cloudinary storage configuration (Client account: tifawhcs).
CLOUDINARY_CLOUD_NAME=tifawhcs
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_SECURE_FOLDER=naqer-menu

# Optional explicit fallback database URL, server-side only. Used only when DATABASE_URL is missing.
NAQER_ACTIVE_DATABASE_URL=

# ---------------------------------------------------------------------------
# Dev/QA-only credentials. These are NOT production credentials.
# The seed and QA scripts refuse to run unless these are set explicitly.
# Never set these to production values and never commit real values.
# ---------------------------------------------------------------------------
SEED_ADMIN_PASSWORD=CHANGE_ME_LOCAL_DEV_ONLY_ADMIN_PASSWORD
SEED_EDITOR_PASSWORD=CHANGE_ME_LOCAL_DEV_ONLY_EDITOR_PASSWORD
QA_ADMIN_PASSWORD=CHANGE_ME_LOCAL_DEV_ONLY_QA_PASSWORD
