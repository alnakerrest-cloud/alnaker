# Environment files: real values must never be committed.
# Example templates stay trackable via the negations below.
.env
.env.*
!.env.example
!*.env.example
.vercel

# Prisma 7 generated client (recreate with `npx prisma generate`)
lib/generated/prisma


# Local backups created during Phase 1
.phase1-backup

# Production database backups — never commit or track SQL dumps
backups/
*.sql
*.dump
*.backup

# Prisma migration SQL is required source — keep it trackable even though `*.sql`
# above targets database dumps.
!prisma/migrations/**/*.sql

# Logs
*.log
dev.log
server.log
diag.log
build*.log
pw-*.log

